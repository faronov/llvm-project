# RUN: llc -mtriple=tc32-unknown-none-elf -run-pass=tc32-immediate-expand -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=thumbv6m-unknown-none-eabi -run-pass=tc32-immediate-expand -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=ARM

--- |
  define i32 @unrelated(i32 %x) { ret i32 %x }
  define i32 @immediates(i32 %x) { ret i32 %x }
...
---
name: unrelated
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0

    ; COPY, tMOVi8 and tBX_RET have fewer operands than immediate arithmetic.
    ; CHECK-LABEL: name: unrelated
    ; CHECK: %0:tgpr = COPY $r0
    ; CHECK-NEXT: %1:tgpr, dead $cpsr = tMOVi8 42, 14 /* CC::al */, $noreg
    ; CHECK-NEXT: %2:tgpr, dead $cpsr = tADDrr %0, %1, 14 /* CC::al */, $noreg
    ; CHECK-NEXT: $r0 = COPY %2
    ; CHECK-NEXT: tBX_RET 14 /* CC::al */, $noreg, implicit $r0
    %0:tgpr = COPY $r0
    %1:tgpr, dead $cpsr = tMOVi8 42, 14, $noreg
    %2:tgpr, dead $cpsr = tADDrr %0, %1, 14, $noreg
    $r0 = COPY %2
    tBX_RET 14, $noreg, implicit $r0
...
---
name: immediates
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0

    ; CHECK-LABEL: name: immediates
    ; CHECK: %0:tgpr = COPY $r0
    ; CHECK-NEXT: %[[ADD3:[0-9]+]]:tgpr, dead $cpsr = tMOVi8 7, 14 /* CC::al */, $noreg
    ; CHECK-NEXT: %1:tgpr, dead $cpsr = tADDrr %0, killed %[[ADD3]], 14 /* CC::al */, $noreg
    ; CHECK-NEXT: %[[SUB3:[0-9]+]]:tgpr, dead $cpsr = tMOVi8 3, 14 /* CC::al */, $noreg
    ; CHECK-NEXT: %2:tgpr, dead $cpsr = tSUBrr %1, killed %[[SUB3]], 14 /* CC::al */, $noreg
    ; CHECK-NEXT: %[[ADD8:[0-9]+]]:tgpr, dead $cpsr = tMOVi8 255, 14 /* CC::al */, $noreg
    ; CHECK-NEXT: %3:tgpr, dead $cpsr = tADDrr %2, killed %[[ADD8]], 14 /* CC::al */, $noreg
    ; CHECK-NEXT: %[[SUB8:[0-9]+]]:tgpr, dead $cpsr = tMOVi8 128, 14 /* CC::al */, $noreg
    ; CHECK-NEXT: %4:tgpr, $cpsr = tSUBrr %3, killed %[[SUB8]], 14 /* CC::al */, $noreg
    ; CHECK-NEXT: $r0 = COPY %4
    ; CHECK-NEXT: tBX_RET 14 /* CC::al */, $noreg, implicit $r0, implicit $cpsr

    ; ARM-LABEL: name: immediates
    ; ARM: %0:tgpr = COPY $r0
    ; ARM-NEXT: %1:tgpr, dead $cpsr = tADDi3 %0, 7, 14 /* CC::al */, $noreg
    ; ARM-NEXT: %2:tgpr, dead $cpsr = tSUBi3 %1, 3, 14 /* CC::al */, $noreg
    ; ARM-NEXT: %3:tgpr, dead $cpsr = tADDi8 %2, 255, 14 /* CC::al */, $noreg
    ; ARM-NEXT: %4:tgpr, $cpsr = tSUBi8 %3, 128, 14 /* CC::al */, $noreg
    ; ARM-NEXT: $r0 = COPY %4
    ; ARM-NEXT: tBX_RET 14 /* CC::al */, $noreg, implicit $r0, implicit $cpsr
    %0:tgpr = COPY $r0
    %1:tgpr, dead $cpsr = tADDi3 %0, 7, 14, $noreg
    %2:tgpr, dead $cpsr = tSUBi3 %1, 3, 14, $noreg
    %3:tgpr, dead $cpsr = tADDi8 %2, 255, 14, $noreg
    %4:tgpr, $cpsr = tSUBi8 %3, 128, 14, $noreg
    $r0 = COPY %4
    tBX_RET 14, $noreg, implicit $r0, implicit $cpsr
...
