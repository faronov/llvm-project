# RUN: llc -mtriple=tc32-unknown-none-elf -run-pass=arm-cp-islands -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=thumbv6m-unknown-none-eabi -run-pass=arm-cp-islands -verify-machineinstrs %s -o - | FileCheck %s

# Removing the most-aligned entry changes the island's own offset and known
# bits, even when other entries remain. The same applies to an emptied island.
# CHECK-LABEL: name: lower_alignment
# CHECK: bb.1 (align 4):
# CHECK-NEXT: CONSTPOOL_ENTRY 1, %const.1, 4
# CHECK-LABEL: name: empty_island
# CHECK-NOT: CONSTPOOL_ENTRY
# CHECK: bb.1:

--- |
  define void @lower_alignment() { ret void }
  define void @empty_island() { ret void }
...
---
name: lower_alignment
alignment: 2
tracksRegLiveness: true
constants:
  - id: 0
    value: i64 1
    alignment: 8
  - id: 1
    value: i32 2
    alignment: 4
body: |
  bb.0:
    dead $r0 = tLDRpci %const.1, 14, $noreg
    tPOP_RET 14, $noreg, def $pc
...
---
name: empty_island
alignment: 2
tracksRegLiveness: true
constants:
  - id: 0
    value: i64 1
    alignment: 8
body: |
  bb.0:
    tPOP_RET 14, $noreg, def $pc
...
